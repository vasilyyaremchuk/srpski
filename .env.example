# --- Required ---
# Claude: translation, explanations, reply suggestions
ANTHROPIC_API_KEY=
# OpenAI: speech-to-text only (Claude API does not accept audio)
OPENAI_API_KEY=
# Any secret phrase. The app asks for it once per device, so strangers
# who find your Vercel URL can't spend your API credits.
APP_PASSCODE=

# --- Optional: model overrides ---
# Fast model for the live translation line
# ANTHROPIC_FAST_MODEL=claude-haiku-5-5
# Smarter model for notes + reply suggestions
# ANTHROPIC_SMART_MODEL=claude-sonnet-5-5
# Speech-to-text model (gpt-4o-transcribe | gpt-4o-mini-transcribe | whisper-1)
# OPENAI_STT_MODEL=gpt-4o-transcribe

# --- Optional: Supabase history (leave empty to skip saving) ---
# Use the SAME project for local and Vercel so both share one database.
SUPABASE_URL=
# Settings -> API Keys -> secret key (server only, never expose to the browser)
SUPABASE_SECRET_KEY=
